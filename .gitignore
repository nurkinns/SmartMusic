# --- Секреты (НИКОГДА не коммитить) ---
.env
*.env
!.env.example
token.json
youtube_tokens.json
client_secret.json
client_secret_*.json
credentials.json
service-account*.json

# --- Скачанное аудио ---
# Кэш треков, которые уже играли. На диске это сотни мегабайт, в
# репозитории им не место: пользователь удаляет папку руками, программа
# скачает нужное заново.
audio_cache/

# --- Логи работы ---
# Журнал каждого запуска. Личный файл пользователя, к проекту отношения
# не имеет. Крутится сам, старые логи удаляются (см. src/app_log.py).
logs/

# --- Персональные данные пользователя ---
user_vibe_db.json
# Замеры звука: кэш между запусками, пользователю нечего тут коммитить
user_vibe_db_audio.json
# Настройка октавы, которую человек подбирает кнопками под свой вкус.
# У каждого она своя, в репозитории ей не место.
user_octave_tuning.json
*.db
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- Логи и временное ---
# logs/ описана выше, рядом с audio_cache/ - там объяснение, зачем папка.
*.log
tmp/
temp/

# --- Заметки для себя, не часть проекта ---
SESSION_HANDOFF.md
WORK_PLAN.md
# --- Резервные копии базы треков ---
*.backup.json
user_vibe_db.*.json

# --- Инструменты ---
.aider*
.mypy_cache/
.pytest_cache/
.ruff_cache/
