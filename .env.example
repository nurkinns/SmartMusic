# ==========================================================================
#  СКОПИРУЙ ЭТОТ ФАЙЛ КАК ".env" (файл .env НИКОГДА не коммитится в git).
#
#  Облачный ИИ (Gemini) из проекта убран: он не работает в России.
#  Используется локальная модель через Ollama - ключей не нужно.
# ==========================================================================

# --- Локальная нейросеть ---
# Модель. Скачать один раз командой:  ollama pull qwen2.5:3b
# Запасная (уже была установлена):  qwen2.5-coder:7b - подхватится сама
OLLAMA_MODEL=qwen2.5:3b

# Адрес демона Ollama. Меняй, только если он запущен не на стандартном порту.
OLLAMA_HOST=http://localhost:11434

# --- YouTube OAuth ---
# Файл OAuth-клиента Google (скачивается из Google Cloud Console)
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json
# Куда сохранять токены авторизации YouTube
YOUTUBE_TOKEN_FILE=token.json
